# ==============================================================================
# MediFlow — Variáveis de Ambiente e Segredos (Exemplo Seguro)
# NUNCA faça commit de arquivos .env reais com chaves no GitHub.
# No Netlify: configure estas variáveis em Site Configuration > Environment variables.
# ==============================================================================

# --- Obrigatório (IA Multimodal no Servidor) ---
# Chave da Gemini API (nunca exposta ao navegador)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- URL Pública da Aplicação ---
# No Netlify, as variáveis URL / DEPLOY_PRIME_URL já são injetadas automaticamente.
# Defina APP_URL caso use domínio customizado ou execução local/Cloud Run.
APP_URL="MY_APP_URL"

# --- Chaves Criptográficas de Sessão e Cofre (Recomendado em Produção/Netlify) ---
# Gere com: openssl rand -hex 32
SESSION_SECRET=""
ENCRYPTION_MASTER_KEY=""

# --- Modo Demo vs Produção Estrita ---
# Mantenha "false" (ou omitido) para a demo pública no Netlify.
# Defina "true" para bloquear login demo e exigir apenas OAuth corporativo real.
DISABLE_DEMO_LOGIN="false"

# --- OAuth Real Google & GitHub (Opcional — Demo OAuth funciona se omitido) ---
# Callback URLs autorizadas no Google Cloud / GitHub OAuth App:
#   https://SEU-SITE.netlify.app/auth/callback/google
#   https://SEU-SITE.netlify.app/auth/callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Listas opcionais de e-mails separados por vírgula para atribuir papéis RBAC no OAuth real
OAUTH_ADMIN_EMAILS=""
OAUTH_AUDITOR_EMAILS=""

# --- Oracle Cloud Infrastructure (OCI) Object Storage — Always Free ---
OCI_BUCKET_NAME="mediflow-documentos-clinicos"
OCI_NAMESPACE=""
OCI_REGION="sa-saopaulo-1"
# Opção A: Pre-Authenticated Request (PAR) Base URL com permissão de Leitura/Escrita
OCI_PAR_BASE_URL=""
# Opção B: Credenciais S3-Compatible da OCI
OCI_S3_ENDPOINT=""
OCI_ACCESS_KEY_ID=""
OCI_SECRET_ACCESS_KEY=""
